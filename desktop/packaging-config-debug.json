{
    "appId": "org.ucost.discoveryhub",
    "productName": "UCOST Discovery Hub",
    "directories": {
        "output": "dist_debug",
        "buildResources": "build"
    },
    "files": [
        "main.js",
        "src/**/*",
        "scripts/**/*",
        "requirements/**/*",
        "docs/**/*",
        "!src/**/*.map",
        "package.json"
    ],
    "extraResources": [
        {
            "from": "../project/backend/backend",
            "to": "backend",
            "filter": [
                "dist/**/*",
                "prisma/**/*",
                "node_modules/**/*",
                "package.json",
                "!src/**/*",
                "!**/*.ts",
                "!**/*.map",
                "!.env",
                "!*.db",
                "!uploads/**/*",
                "!temp/**/*",
                "!backups/**/*",
                "!training-data/**/*"
            ]
        },
        {
            "from": "../project/frontend/ucost-discovery-hub/dist",
            "to": "frontend/dist",
            "filter": [
                "**/*"
            ]
        },
        {
            "from": "../project/chatbot-mini",
            "to": "chatbot",
            "filter": [
                "dist/**/*",
                "node_modules/**/*",
                "package.json",
                "!src/**/*",
                "!**/*.ts",
                "!**/*.map"
            ]
        },
        {
            "from": "../project/embed-service",
            "to": "embed-service",
            "filter": [
                "**/*.py",
                "requirements.txt",
                "!**/__pycache__/**",
                "!**/*.pyc"
            ]
        },
        {
            "from": "../gemma/infer",
            "to": "gemma/infer",
            "filter": [
                "**/*.py",
                "requirements.txt",
                "!**/__pycache__/**",
                "!**/*.pyc"
            ]
        },
        {
            "from": "../project/ocr-engine",
            "to": "ocr-engine",
            "filter": [
                "**/*",
                "!**/__pycache__/**",
                "!**/*.pyc",
                "!node_modules/**/*"
            ]
        },
        {
            "from": "../docs/exhibits.csv",
            "to": "data/exhibits.csv"
        },
        {
            "from": "requirements",
            "to": "requirements",
            "filter": [
                "**/*.txt"
            ]
        },
        {
            "from": "resources/python",
            "to": "python",
            "filter": [
                "**/*"
            ]
        },
        {
            "from": "resources/models",
            "to": "models",
            "filter": [
                "**/*"
            ]
        },
        {
            "from": "resources/tesseract",
            "to": "tesseract",
            "filter": [
                "**/*"
            ]
        },
        {
            "from": "docs",
            "to": "docs",
            "filter": [
                "**/*.md"
            ]
        }
    ],
    "win": {
        "target": [
            {
                "target": "dir",
                "arch": [
                    "x64"
                ]
            }
        ],
        "icon": "build/icon.ico",
        "requestedExecutionLevel": "asInvoker"
    },
    "extraMetadata": {
        "main": "main.js",
        "author": "Uttarakhand Science and Technology Council",
        "description": "UCOST Discovery Hub - Museum Exhibit Management System"
    }
}